rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Coleção de tarefas do TaskFlow
    // Acesso protegido: somente usuários devidamente autenticados via Firebase Auth podem ler e gravar tarefas
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // Bloqueia qualquer acesso não autorizado em outras coleções
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
